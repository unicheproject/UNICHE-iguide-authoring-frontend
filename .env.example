# Local development configuration for the iGuide CMS. Copy to .env.local (never committed) and fill in.
# Deployments inject the same values at runtime through public/config.js instead.

# UNICHE Keycloak base URL, without /realms/...
# Live realm: https://idp.uniche-eccch.eu
# Local test realm from dev/docker-compose.yml: http://localhost:8180
VITE_IDP_URL=https://idp.uniche-eccch.eu
VITE_REALM=uniche
# Public OIDC client of the CMS; needs http://localhost:5173/* as a redirect URI and
# http://localhost:5173 as a web origin, and an audience mapper adding uniche-platform.
VITE_CLIENT_ID=iguide-web
VITE_AUDIENCE=uniche-platform

# Authoring API, ending in /api/v1
VITE_API_BASE_URL=http://localhost:8080/iguide/api/v1
